# Supabase project (Settings → API). The publishable key (sb_publishable_...)
# is safe to ship to the browser — row access is enforced by the backend's
# allowlist. This is the modern replacement for the legacy anon JWT key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where /api/* is proxied in dev (next.config.ts rewrites).
BACKEND_ORIGIN=http://localhost:8000

# DEV ONLY: skip Supabase login entirely (pair with the backend's
# DEV_AUTH_BYPASS_EMAIL). NEVER set in production.
NEXT_PUBLIC_DEV_AUTH_BYPASS=
